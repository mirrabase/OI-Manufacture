rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function activeOrganization(organizationId) {
      return organizationId is string
        && firestore.exists(/databases/(default)/documents/organizations/$(organizationId))
        && firestore.get(/databases/(default)/documents/organizations/$(organizationId)).data.active == true;
    }
    function requestOwner(uid, rfqId) {
      return firestore.exists(/databases/(default)/documents/rfqs/$(rfqId))
        && firestore.get(/databases/(default)/documents/rfqs/$(rfqId)).data.ownerUid == uid;
    }
    function manufacturerCanRead(uid, rfqId) {
      return firestore.exists(/databases/(default)/documents/rfqs/$(rfqId))
        && requestOwner(uid, rfqId)
        && firestore.exists(/databases/(default)/documents/manufacturers/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/manufacturers/$(request.auth.uid)).data.active == true
        && firestore.get(/databases/(default)/documents/manufacturers/$(request.auth.uid)).data.organizationId == firestore.get(/databases/(default)/documents/rfqs/$(rfqId)).data.organizationId
        && activeOrganization(firestore.get(/databases/(default)/documents/rfqs/$(rfqId)).data.organizationId)
        && firestore.get(/databases/(default)/documents/rfqs/$(rfqId)).data.status in ['Submitted', 'Quoted', 'Preparing Production', 'In Production', 'Completed'];
    }
    match /rfqs/{uid}/{rfqId}/{fileName} {
      allow read: if signedIn() && ((request.auth.uid == uid && requestOwner(uid, rfqId)) || manufacturerCanRead(uid, rfqId));
      allow write: if signedIn() && request.auth.uid == uid && requestOwner(uid, rfqId)
        && firestore.get(/databases/(default)/documents/rfqs/$(rfqId)).data.status == 'Draft'
        && fileName.matches('.*\\.[sS][tT][lL]')
        && request.resource.size <= 50 * 1024 * 1024
        && request.resource.contentType == 'model/stl';
    }
  }
}
