{
  "name": "@oi-manufacture/server",
  "version": "0.0.1",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --watch src/index.ts",
    "start": "node --env-file-if-exists=.env.local src/index.ts",
    "test": "node --test tests/*.test.js",
    "r2:dev": "wrangler dev --config wrangler.jsonc --local --ip 127.0.0.1 --port 8788",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests eslint.config.js --max-warnings 0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "@genkit-ai/google-genai": "^1.42.0",
    "@hono/node-server": "^1.19.0",
    "firebase-admin": "^14.5.0",
    "genkit": "^1.42.0",
    "hono": "^4.9.0"
  },
  "devDependencies": {
    "wrangler": "^4.40.0",
    "@types/node": "^22",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/eslint-config": "workspace:*",
    "typescript": "^5",
    "eslint": "^10"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "type": "module"
}
