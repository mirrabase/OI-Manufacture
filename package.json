{
  "name": "ai-builder-starter",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "node scripts/dev.mjs",
    "dev:web": "turbo dev --filter=web",
    "emulators": "firebase emulators:start --project demo-oi-manufacture",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "seed:local": "node scripts/local-firebase.mjs",
    "slicing": "node scripts/slicing-worker.mjs",
    "test:slicing": "node --test scripts/slicing.test.mjs",
    "verify:local": "node scripts/verify-local.mjs",
    "verify:api": "node scripts/verify-api.mjs",
    "test:server": "pnpm --filter @oi-manufacture/server test",
    "verify:worker": "node scripts/verify-worker.mjs"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.33.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.7",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.18.0"
  }
}
